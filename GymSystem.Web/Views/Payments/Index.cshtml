@model IEnumerable<GymSystem.Application.Dtos.PaymentDtos.PaymentDto>

@{
    ViewData["Title"] = "Payments Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark">Payments Management</h2>
            <p class="text-muted mb-0">Manage gym payments and financial records seamlessly.</p>
        </div>
        <!-- زر فتح بوب أب الإضافة الفخم -->
        <button type="button" class="btn btn-primary px-4 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createPaymentModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Payment
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="py-3 ps-4">ID</th>
                        <th class="py-3">Member</th>
                        <th class="py-3">Plan</th>
                        <th class="py-3">Amount</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Method</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var payment in Model)
                        {
                            <tr>
                                <!-- عرض الـ ID الرقمي الأساسي -->
                                <td class="ps-4 fw-bold text-secondary">@payment.Id</td>
                                <td class="fw-semibold text-primary">@payment.MemberName</td>
                                <td>@payment.PlanName</td>
                                <td><strong class="text-success">@payment.Amount.ToString("N2")</strong> SAR</td>
                                <td><i class="bi bi-calendar text-muted me-1"></i> @payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>@payment.PaymentMethod</td>
                                <td>
                                    @if (payment.Status == "Paid")
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Paid</span>
                                    }
                                    else if (payment.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">Cancelled</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <!-- زر التعديل (يعتمد على الـ UID في الخلفية والمودال) -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning px-3 me-1 rounded-pill"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editPaymentModal_@payment.UID">
                                        Edit
                                    </button>

                                    <!-- زر الحذف (يعتمد على الـ UID في الخلفية والمودال) -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger px-3 rounded-pill"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deletePaymentModal_@payment.UID">
                                        Delete
                                    </button>
                                </td>
                            </tr>

                            <!-- ================= 1. نافذة بوب أب التعديل (Edit Modal) ================= -->
                            <div class="modal fade" id="editPaymentModal_@payment.UID" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow rounded-4">
                                        <form asp-action="Edit" asp-route-uid="@payment.UID" method="post">
                                            <div class="modal-header bg-warning text-dark px-4">
                                                <h5 class="modal-title fw-bold">Edit Payment (#@payment.Id)</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4 text-start">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Subscription (Member & Plan)</label>
                                                    <select name="SubscriptionId" class="form-select rounded-3" required>
                                                        <option value="">-- Choose Subscription --</option>
                                                        @if (ViewBag.Subscriptions != null)
                                                        {
                                                            foreach (var sub in ViewBag.Subscriptions)
                                                            {
                                                                <option value="@sub.Id" selected="@(payment.SubscriptionId == sub.Id)">
                                                                    @sub.MemberName - @sub.PlanName
                                                                </option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Amount</label>
                                                    <input type="number" step="0.01" name="Amount" value="@payment.Amount" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Payment Date</label>
                                                    <input type="date" name="PaymentDate" value="@payment.PaymentDate.ToString("yyyy-MM-dd")" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Payment Method</label>
                                                    <select name="PaymentMethod" class="form-select rounded-3">
                                                        <option value="Cash" selected="@(payment.PaymentMethod == "Cash")">Cash</option>
                                                        <option value="Card" selected="@(payment.PaymentMethod == "Card")">Card</option>
                                                        <option value="Transfer" selected="@(payment.PaymentMethod == "Transfer")">Transfer</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Status</label>
                                                    <select name="Status" class="form-select rounded-3">
                                                        <option value="Paid" selected="@(payment.Status == "Paid")">Paid</option>
                                                        <option value="Pending" selected="@(payment.Status == "Pending")">Pending</option>
                                                        <option value="Cancelled" selected="@(payment.Status == "Cancelled")">Cancelled</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light px-4 py-3">
                                                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-warning px-4 rounded-pill fw-semibold text-dark">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- ================= 2. نافذة بوب أب الحذف (Delete Modal) ================= -->
                            <div class="modal fade" id="deletePaymentModal_@payment.UID" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow rounded-4">
                                        <form asp-action="Delete" asp-route-uid="@payment.UID" method="post">
                                            <div class="modal-header bg-danger text-white px-4">
                                                <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4 text-start">
                                                <div class="text-center py-3">
                                                    <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                                                    <p class="mb-1 text-muted">Are you sure you want to delete payment record?</p>
                                                    <h5 class="text-danger fw-bold">Payment #@payment.Id (@payment.MemberName)</h5>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light px-4 py-3">
                                                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">Yes, Delete</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No payment records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= 3. نافذة بوب أب الإضافة (Create Modal) ================= -->
<div class="modal fade" id="createPaymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="Add" method="post">
                <div class="modal-header bg-primary text-white px-4">
                    <h5 class="modal-title fw-bold">Add New Payment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subscription (Select Member & Plan)</label>
                        <select name="SubscriptionId" class="form-select rounded-3" required>
                            <option value="">-- Choose Subscription --</option>
                            @if (ViewBag.Subscriptions != null)
                            {
                                foreach (var sub in ViewBag.Subscriptions)
                                {
                                    <option value="@sub.Id">@sub.MemberName - @sub.PlanName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount</label>
                        <input type="number" step="0.01" name="Amount" class="form-control rounded-3" placeholder="e.g. 500.00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Date</label>
                        <input type="date" name="PaymentDate" class="form-control rounded-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Method</label>
                        <select name="PaymentMethod" class="form-select rounded-3">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Transfer">Transfer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select name="Status" class="form-select rounded-3">
                            <option value="Paid">Paid</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold">Save Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>