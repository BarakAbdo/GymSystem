@model IEnumerable<GymSystem.Application.Dtos.MemberDtos.MemberDto>

@{
    ViewData["Title"] = "Members Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark">Members Management</h2>
            <p class="text-muted mb-0">Manage gym members and personal profiles seamlessly.</p>
        </div>
        <!-- زر فتح بوب أب الإضافة الفخم -->
        <button type="button" class="btn btn-primary px-4 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createMemberModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Member
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="py-3 ps-4">ID</th>
                        <th class="py-3">Name</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Phone</th>
                        <th class="py-3 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        <tr>
                            <!-- عرض الـ ID الرقمي الأساسي -->
                            <td class="ps-4 fw-bold text-secondary">@member.Id</td>
                            <td class="ps-4 fw-semibold text-primary">@member.Name</td>
                            <td><i class="bi bi-envelope text-muted me-1"></i> @member.Email</td>
                            <td><i class="bi bi-telephone text-muted me-1"></i> @member.Phone</td>
                            <td class="text-center pe-4">
                                <!-- زر التعديل (يعتمد على UID) -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning px-3 me-1 rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editMemberModal_@member.UID">
                                    Edit
                                </button>

                                <!-- زر الحذف (يعتمد على UID) -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger px-3 rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteMemberModal_@member.UID">
                                    Delete
                                </button>
                            </td>
                        </tr>

                        <!-- 1. نافذة بوب أب التعديل (Edit Modal) -->
                        <div class="modal fade" id="editMemberModal_@member.UID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <form asp-action="Edit" method="post">
                                        <input type="hidden" name="uid" value="@member.UID" />
                                        <div class="modal-header bg-warning text-dark px-4">
                                            <h5 class="modal-title fw-bold">Edit Member (#@member.Id): @member.Name</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Full Name</label>
                                                <input type="text" name="Name" value="@member.Name" class="form-control rounded-3" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Email</label>
                                                <input type="email" name="Email" value="@member.Email" class="form-control rounded-3" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Phone</label>
                                                <input type="text" name="Phone" value="@member.Phone" class="form-control rounded-3" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light px-4 py-3">
                                            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-warning px-4 rounded-pill fw-semibold">Save Changes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- 2. نافذة بوب أب الحذف (Delete Modal) -->
                        <div class="modal fade" id="deleteMemberModal_@member.UID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="uid" value="@member.UID" />
                                        <div class="modal-header bg-danger text-white px-4">
                                            <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="text-center py-3">
                                                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                                                <p class="mb-1 text-muted">Are you sure you want to delete member:</p>
                                                <h5 class="text-danger fw-bold">#@member.Id - @member.Name</h5>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light px-4 py-3">
                                            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">Yes, Delete</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. نافذة بوب أب الإضافة (Create Modal) الفخمة -->
<div class="modal fade" id="createMemberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white px-4">
                    <h5 class="modal-title fw-bold">Add New Member</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input type="text" name="Name" class="form-control rounded-3" placeholder="e.g. John Doe" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="Email" class="form-control rounded-3" placeholder="e.g. email@domain.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone</label>
                        <input type="text" name="Phone" class="form-control rounded-3" placeholder="e.g. +9665xxxxxxxx" required />
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold">Save Member</button>
                </div>
            </form>
        </div>
    </div>
</div>