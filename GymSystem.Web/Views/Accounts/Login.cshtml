@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Login - Gym Management System</title>
    <!-- استبدال الملف المحلي بـ CDN رسمي يضمن ظهور التصميم فوراً -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <style>
        .login-bg {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        }
    </style>
</head>
<body class="login-bg">
    <div id="layoutAuthentication">
        <div id="layoutAuthentication_content">
            <main>
                <div class="container">
                    <div class="row justify-content-center align-items-center min-vh-100">
                        <div class="col-lg-6 col-md-8">
                            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                                <div class="row g-0">
                                    <!-- قسم ترحيبي فخم على اليسار -->
                                    <div class="col-lg-5 bg-dark text-white d-none d-lg-flex flex-column justify-content-center align-items-center p-4 text-center">
                                        <div class="mb-3">
                                            <i class="fas fa-dumbbell fa-3x text-primary"></i>
                                        </div>
                                        <h4 class="fw-bold mb-2">Gym System</h4>
                                        <p class="small text-muted mb-0">Professional Fitness & Member Management Portal</p>
                                    </div>

                                    <!-- قسم نموذج تسجيل الدخول على اليمين -->
                                    <div class="col-lg-7 p-4 p-md-5 bg-white">
                                        <div class="text-center mb-4">
                                            <h3 class="font-weight-bold text-dark">Welcome Back</h3>
                                            <p class="text-muted small">Please sign in to your account</p>
                                        </div>

                                        <form method="post" asp-action="Login">
                                            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

                                            <div class="form-floating mb-3">
                                                <input class="form-control rounded-3" id="inputUsername" type="text" placeholder="Username" name="username" required />
                                                <label for="inputUsername">Username</label>
                                            </div>

                                            <div class="form-floating mb-3">
                                                <input class="form-control rounded-3" id="inputPassword" type="password" placeholder="Password" name="password" required />
                                                <label for="inputPassword">Password</label>
                                            </div>

                                            <div class="d-grid mb-3">
                                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold shadow-sm">Sign In</button>
                                            </div>
                                        </form>

                                        <div class="text-center mt-3">
                                            <p class="small text-muted">Don't have an account? <a href="/Accounts/Register" class="text-decoration-none">Register here</a></p>
                                        </div>

                                        <div class="text-center mt-4">
                                            <span class="small text-muted">&copy; Gym Management System 2026</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="~/Templete_boot/js/scripts.js"></script>
</body>
</html>