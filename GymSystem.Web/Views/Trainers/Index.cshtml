@model IEnumerable<GymSystem.Application.Dtos.TrainerDtos.TrainerDto>

@{
    ViewData["Title"] = "Trainers Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark">Trainers Management</h2>
            <p class="text-muted mb-0">Manage gym trainers, specialties, and schedules seamlessly.</p>
        </div>
        <!-- زر فتح بوب أب الإضافة الفخم -->
        <button type="button" class="btn btn-primary px-4 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createTrainerModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Trainer
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="py-3 ps-4">ID</th>
                        <th class="py-3">Name</th>
                        <th class="py-3">Specialty</th>
                        <th class="py-3">Phone</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Salary</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var trainer in Model)
                        {
                            <tr>
                                <!-- عرض الـ ID الرقمي الأساسي -->
                                <td class="ps-4 fw-bold text-secondary">@trainer.Id</td>
                                <td class="fw-semibold text-primary">@trainer.Name</td>
                                <td><span class="badge bg-info text-dark">@trainer.Specialty</span></td>
                                <td><i class="bi bi-telephone text-muted me-1"></i> @trainer.Phone</td>
                                <td><i class="bi bi-envelope text-muted me-1"></i> @trainer.Email</td>
                                <td class="fw-bold text-success">@trainer.Salary.ToString("N2") SAR</td>
                                <td>
                                    @if (trainer.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill px-3">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger rounded-pill px-3">Inactive</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <!-- زر التعديل (يعتمد على UID) -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning px-3 me-1 rounded-pill"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editTrainerModal_@trainer.UID">
                                        Edit
                                    </button>

                                    <!-- زر الحذف (يعتمد على UID) -->
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger px-3 rounded-pill"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteTrainerModal_@trainer.UID">
                                        Delete
                                    </button>
                                </td>
                            </tr>

                            <!-- ================= 1. نافذة بوب أب التعديل (Edit Modal) ================= -->
                            <div class="modal fade" id="editTrainerModal_@trainer.UID" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow rounded-4">
                                        <form asp-action="Edit" asp-route-uid="@trainer.UID" method="post">
                                            <div class="modal-header bg-warning text-dark px-4">
                                                <h5 class="modal-title fw-bold">Edit Trainer (#@trainer.Id)</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4 text-start">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Trainer Name</label>
                                                    <input type="text" name="Name" value="@trainer.Name" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Specialty</label>
                                                    <input type="text" name="Specialty" value="@trainer.Specialty" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Phone</label>
                                                    <input type="text" name="Phone" value="@trainer.Phone" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Email</label>
                                                    <input type="email" name="Email" value="@trainer.Email" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Salary</label>
                                                    <input type="number" step="0.01" name="Salary" value="@trainer.Salary" class="form-control rounded-3" required />
                                                </div>
                                                <div class="mb-3 form-check">
                                                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editActive_@trainer.UID" @(trainer.IsActive ? "checked" : "") />
                                                    <label class="form-check-label fw-semibold" for="editActive_@trainer.UID">Is Active</label>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light px-4 py-3">
                                                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-warning px-4 rounded-pill fw-semibold text-dark">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- ================= 2. نافذة بوب أب الحذف (Delete Modal) ================= -->
                            <div class="modal fade" id="deleteTrainerModal_@trainer.UID" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content border-0 shadow rounded-4">
                                        <form asp-action="Delete" asp-route-uid="@trainer.UID" method="post">
                                            <div class="modal-header bg-danger text-white px-4">
                                                <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-4 text-start">
                                                <div class="text-center py-3">
                                                    <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                                                    <p class="mb-1 text-muted">Are you sure you want to delete trainer:</p>
                                                    <h5 class="text-danger fw-bold">#@trainer.Id - @trainer.Name</h5>
                                                </div>
                                            </div>
                                            <div class="modal-footer bg-light px-4 py-3">
                                                <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">Yes, Delete</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No trainers found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= 3. نافذة بوب أب الإضافة (Create Modal) ================= -->
<div class="modal fade" id="createTrainerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white px-4">
                    <h5 class="modal-title fw-bold">Add New Trainer</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Trainer Name</label>
                        <input type="text" name="Name" class="form-control rounded-3" placeholder="e.g. John Smith" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Specialty</label>
                        <input type="text" name="Specialty" class="form-control rounded-3" placeholder="e.g. Bodybuilding / Fitness" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone</label>
                        <input type="text" name="Phone" class="form-control rounded-3" placeholder="e.g. +9665xxxxxxxx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="Email" class="form-control rounded-3" placeholder="e.g. trainer@domain.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Salary</label>
                        <input type="number" step="0.01" name="Salary" class="form-control rounded-3" placeholder="e.g. 4000.00" required />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="createActive" checked />
                        <label class="form-check-label fw-semibold" for="createActive">Is Active</label>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold">Save Trainer</button>
                </div>
            </form>
        </div>
    </div>
</div>