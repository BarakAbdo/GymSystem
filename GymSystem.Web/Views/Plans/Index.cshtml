@model IEnumerable<GymSystem.Application.Dtos.PlanDtos.PlanDto>

@{
    ViewData["Title"] = "Plans Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark">Plans Management</h2>
            <p class="text-muted mb-0">Manage gym subscription plans and pricing seamlessly.</p>
        </div>
        <!-- زر فتح بوب أب الإضافة الفخم -->
        <button type="button" class="btn btn-primary px-4 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createPlanModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Plan
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="py-3 ps-4">ID</th>
                        <th class="py-3">Plan Name</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Duration (Days)</th>
                        <th class="py-3">Price</th>
                        <th class="py-3 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var plan in Model)
                    {
                        <tr>
                            <!-- عرض الـ ID الرقمي الأساسي -->
                            <td class="ps-4 fw-bold text-secondary">@plan.Id</td>
                            <td class="fw-semibold text-primary">@plan.Name</td>
                            <td><span class="badge bg-secondary">@plan.Category</span></td>
                            <td><i class="bi bi-calendar-day text-muted me-1"></i> @plan.DurationDays Days</td>
                            <td class="fw-bold text-success">@plan.Price $</td>
                            <td class="text-center pe-4">
                                <!-- زر التعديل (يعتمد على الـ UID في الخلفية والمودال) -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning px-3 me-1 rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editPlanModal_@plan.UID">
                                    Edit
                                </button>

                                <!-- زر الحذف (يعتمد على الـ UID في الخلفية والمودال) -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger px-3 rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deletePlanModal_@plan.UID">
                                    Delete
                                </button>
                            </td>
                        </tr>

                        <!-- 1. نافذة بوب أب التعديل (Edit Modal) -->
                        <div class="modal fade" id="editPlanModal_@plan.UID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <form asp-action="Edit" method="post">
                                        <input type="hidden" name="uid" value="@plan.UID" />
                                        <div class="modal-header bg-warning text-dark px-4">
                                            <h5 class="modal-title fw-bold">Edit Plan (#@plan.Id): @plan.Name</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Plan Name</label>
                                                <input type="text" name="Name" value="@plan.Name" class="form-control rounded-3" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Category</label>
                                                <input type="text" name="Category" value="@plan.Category" class="form-control rounded-3" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Duration (Days)</label>
                                                <input type="number" name="DurationDays" value="@plan.DurationDays" class="form-control rounded-3" required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Price</label>
                                                <input type="number" step="0.01" name="Price" value="@plan.Price" class="form-control rounded-3" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light px-4 py-3">
                                            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-warning px-4 rounded-pill fw-semibold">Save Changes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- 2. نافذة بوب أب الحذف (Delete Modal) -->
                        <div class="modal fade" id="deletePlanModal_@plan.UID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="uid" value="@plan.UID" />
                                        <div class="modal-header bg-danger text-white px-4">
                                            <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="text-center py-3">
                                                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                                                <p class="mb-1 text-muted">Are you sure you want to delete this plan?</p>
                                                <h5 class="text-danger fw-bold">Plan #@plan.Id (@plan.Name)</h5>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light px-4 py-3">
                                            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">Yes, Delete</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. نافذة بوب أب الإضافة (Create Modal) الفخمة -->
<div class="modal fade" id="createPlanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white px-4">
                    <h5 class="modal-title fw-bold">Add New Plan</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Plan Name</label>
                        <input type="text" name="Name" class="form-control rounded-3" placeholder="e.g. VIP Gold" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category</label>
                        <input type="text" name="Category" class="form-control rounded-3" placeholder="e.g. Monthly / Yearly" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Duration (Days)</label>
                        <input type="number" name="DurationDays" class="form-control rounded-3" placeholder="e.g. 30" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Price</label>
                        <input type="number" step="0.01" name="Price" class="form-control rounded-3" placeholder="e.g. 299.99" required />
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold">Save Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>