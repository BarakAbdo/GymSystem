@using GymSystem.Application.Dtos.PermissionsDtos
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<PermissionDto>

@{
    ViewData["Title"] = "Permissions Management";
    int counter = 1;
}

<div class="container py-3">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white px-3 py-3 rounded-3 shadow-sm border border-light">
        <div>
            <h4 class="fw-bold mb-1" style="color: #1e3c72;">
                <i class="fas fa-key me-2"></i>Permission Management
            </h4>
            <p class="text-muted small mb-0">Manage and view system permissions</p>
        </div>

        <button class="btn text-white px-3 py-2 shadow-sm rounded-3 fw-semibold btn-sm" style="background-color: #1e3c72;"
                data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="fas fa-plus-circle me-1"></i> Create Permission
        </button>
    </div>

    <!-- Permissions Table Card -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="text-white text-uppercase fs-7" style="background-color: #1e3c72;">
                        <tr>
                            <th class="ps-3 py-2" style="width: 60px;">#</th>
                            <th class="py-2" style="width: 80px;">ID</th>
                            <th class="py-2">Name</th>
                            <th class="text-center py-2" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3 text-muted">
                                    <i class="fas fa-lock fa-2x mb-1 d-block text-secondary opacity-50"></i>
                                    No permissions found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var Permission in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted py-2">@counter</td>
                                    @{
                                        counter++;
                                    }

                                    <td class="fw-bold text-muted py-2">@Permission.Id</td>

                                    <td class="fw-semibold text-dark py-2">@Permission.Name</td>

                                    <td class="text-center py-2">
                                        <div class="d-flex justify-content-center gap-1">
                                            <!-- Edit Button -->
                                            <button class="btn btn-outline-warning btn-sm px-2 py-1 rounded-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editModal-@Permission.Id">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </button>

                                            <!-- Delete Button -->
                                            <button class="btn btn-outline-danger btn-sm px-2 py-1 rounded-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal-@Permission.Id">
                                                <i class="fas fa-trash-alt me-1"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>

<!-- ================================================= -->
<!-- CREATE MODAL -->
<!-- ================================================= -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow rounded-3">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" style="color: #1e3c72;">
                        <i class="fas fa-plus-circle me-1"></i> Create Permission
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Permission Name</label>
                        <input name="Name" class="form-control" placeholder="Enter permission name" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white btn-sm px-3" style="background-color: #1e3c72;">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================================================= -->
<!-- EDIT + DELETE MODALS -->
<!-- ================================================= -->
@foreach (var Permission in Model)
{
    <!-- EDIT MODAL -->
    <div class="modal fade" id="editModal-@Permission.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow rounded-3">
                <form asp-action="Edit" method="post">
                    <input type="hidden" name="Id" value="@Permission.Id" />
                    <input type="hidden" name="UID" value="@Permission.UID" />

                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" style="color: #1e3c72;">
                            <i class="fas fa-edit me-1"></i> Edit Permission
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Permission Name</label>
                            <input type="text" name="Name" value="@Permission.Name" class="form-control" required />
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning btn-sm px-3 text-dark fw-semibold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal-@Permission.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow rounded-3">
                <form asp-controller="Permissions" asp-action="Delete" method="post">
                    <input type="hidden" name="UID" value="@Permission.UID" />

                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold text-danger">
                            <i class="fas fa-trash-alt me-1"></i> Delete Permission
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <p class="mb-0">Are you sure you want to delete permission <strong>@Permission.Name</strong>?</p>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm px-3">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}