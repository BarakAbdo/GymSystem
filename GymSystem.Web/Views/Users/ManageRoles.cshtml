@using GymSystem.Application.Dtos
@model UserRolesVM

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-header bg-primary text-white">
            <h4>Manage Roles</h4>
        </div>

        <div class="card-body">

            <h5 class="mb-4">
                User: @Model.UserName
            </h5>

            <form asp-action="ManageRoles" method="post">

                <input type="hidden" asp-for="UserId" />

                @if (Model.Roles != null)
                {
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <div class="form-check mb-3">
                            <input type="hidden" asp-for="Roles[i].RoleId" />
                            <input type="hidden" asp-for="Roles[i].RoleUid" />
                            <input type="hidden" asp-for="Roles[i].RoleName" />

                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="Roles[i].IsSelected"
                                   id="role_@i" />

                            <label class="form-check-label"
                                   for="role_@i">
                                @Model.Roles[i].RoleName
                            </label>
                        </div>
                    }
                }

                <button type="submit" class="btn btn-success">
                    Save Roles
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>