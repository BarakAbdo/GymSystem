@model IEnumerable<GymSystem.Application.Dtos.SubscriptionsDtos.SubscriptionDto>

@{
    ViewData["Title"] = "Subscriptions Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold text-dark">Subscriptions Management</h2>
            <p class="text-muted mb-0">Manage member memberships and tracking seamlessly.</p>
        </div>
        <!-- زر فتح بوب أب الإضافة الفخم -->
        <button type="button" class="btn btn-primary px-4 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createSubscriptionModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Subscription
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark text-uppercase fs-7">
                    <tr>
                        <th class="py-3 ps-4">ID</th>
                        <th class="py-3">Member</th>
                        <th class="py-3">Plan Name</th>
                        <th class="py-3">Category</th>
                        <th class="py-3">Price</th>
                        <th class="py-3">Start Date</th>
                        <th class="py-3">End Date</th>
                        <th class="py-3 text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model)
                    {
                        <tr>
                            <!-- عرض الـ ID الرقمي الأساسي -->
                            <td class="ps-4 fw-bold text-secondary">@sub.Id</td>
                            <td class="fw-semibold text-primary">@sub.MemberName</td>
                            <td>@sub.PlanName</td>
                            <td><span class="badge bg-secondary">@sub.PlanCategory</span></td>
                            <td class="fw-bold text-success">@sub.Price $</td>
                            <td><i class="bi bi-calendar-check text-muted me-1"></i> @sub.StartDate.ToShortDateString()</td>
                            <td><i class="bi bi-calendar-x text-muted me-1"></i> @sub.EndDate.ToShortDateString()</td>
                            <td class="text-center pe-4">
                                <!-- زر التعديل (يعتمد على UID) -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-warning px-3 me-1 rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editSubscriptionModal_@sub.UID">
                                    Edit
                                </button>

                                <!-- زر الحذف (يعتمد على UID) -->
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger px-3 rounded-pill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteSubscriptionModal_@sub.UID">
                                    Delete
                                </button>
                            </td>
                        </tr>

                        <!-- 1. نافذة بوب أب التعديل (Edit Modal) -->
                        <div class="modal fade" id="editSubscriptionModal_@sub.UID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <form asp-action="Edit" method="post">
                                        <input type="hidden" name="uid" value="@sub.UID" />
                                        <div class="modal-header bg-warning text-dark px-4">
                                            <h5 class="modal-title fw-bold">Edit Subscription (#@sub.Id)</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Member</label>
                                                <select name="MemberId" class="form-select rounded-3" asp-items="ViewBag.Members" required>
                                                    <option value="">-- Select Member --</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Plan</label>
                                                <select name="PlanId" class="form-select rounded-3" asp-items="ViewBag.Plans" required>
                                                    <option value="">-- Select Plan --</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Start Date</label>
                                                <input type="date" name="StartDate" value="@sub.StartDate.ToString("yyyy-MM-dd")" class="form-control rounded-3" required />
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light px-4 py-3">
                                            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-warning px-4 rounded-pill fw-semibold">Save Changes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- 2. نافذة بوب أب الحذف (Delete Modal) -->
                        <div class="modal fade" id="deleteSubscriptionModal_@sub.UID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow rounded-4">
                                    <form asp-action="Delete" method="post">
                                        <input type="hidden" name="uid" value="@sub.UID" />
                                        <div class="modal-header bg-danger text-white px-4">
                                            <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4 text-start">
                                            <div class="text-center py-3">
                                                <i class="bi bi-exclamation-triangle text-danger display-4 mb-3"></i>
                                                <p class="mb-1 text-muted">Are you sure you want to delete subscription #@sub.Id for:</p>
                                                <h5 class="text-danger fw-bold">@sub.MemberName (@sub.PlanName)</h5>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-light px-4 py-3">
                                            <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger px-4 rounded-pill fw-semibold">Yes, Delete</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3. نافذة بوب أب الإضافة (Create Modal) الفخمة -->
<div class="modal fade" id="createSubscriptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="Create" method="post">
                <div class="modal-header bg-primary text-white px-4">
                    <h5 class="modal-title fw-bold">Add New Subscription</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 text-start">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Member</label>
                        <select name="MemberId" class="form-select rounded-3" asp-items="ViewBag.Members" required>
                            <option value="">-- Choose Member --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Plan</label>
                        <select name="PlanId" class="form-select rounded-3" asp-items="ViewBag.Plans" required>
                            <option value="">-- Choose Plan --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Start Date</label>
                        <input type="date" name="StartDate" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold">Save Subscription</button>
                </div>
            </form>
        </div>
    </div>
</div>