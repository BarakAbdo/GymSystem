@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark">Gym Dashboard</h2>
        <p class="text-muted mb-0">Quick overview of your gym performance.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4">
                <h6 class="text-uppercase fw-semibold">Total Members</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalMembers</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark p-4">
                <h6 class="text-uppercase fw-semibold">Total Plans</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalPlans</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-4">
                <h6 class="text-uppercase fw-semibold">Total Subscriptions</h6>
                <h2 class="fw-bold mb-0">@ViewBag.TotalSubscriptions</h2>
            </div>
        </div>
    </div>
</div>